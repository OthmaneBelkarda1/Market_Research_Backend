# Copie ce fichier en `.env` et remplace les valeurs. `.env` n'est jamais commite.

# local | testing | staging | production  (les docs /docs sont exposees en local et staging)
ENVIRONMENT=local

# Supabase -> Settings -> Database -> Connection string -> mode "Session pooler",
# en remplacant le schema `postgresql://` par `postgresql+asyncpg://`
# et en supprimant les parametres de requete (ex. `?sslmode=require`, non supporte par asyncpg).
DATABASE_URL=postgresql+asyncpg://postgres.abcdefghijklmnopqrst:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# Base dediee aux tests (projet ou base Supabase separe) : la suite de tests la vide entre chaque test.
TEST_DATABASE_URL=postgresql+asyncpg://postgres.abcdefghijklmnopqrst:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# Origines du front, separees par des virgules. SANS CELA, AUCUN NAVIGATEUR NE PEUT
# APPELER L'API : il refuse une reponse cross-origin qui ne le nomme pas, et l'appel
# echoue en erreur reseau, jamais en code HTTP. Les clients serveur (curl, tests) ne sont
# pas concernes -- c'est pourquoi le manque ne se voit qu'a l'arrivee d'un front web.
# Jamais `*` : l'API n'a aucune authentification, donc une origine autorisee par accident
# est une origine depuis laquelle n'importe quel site peut la piloter.
CORS_ORIGINS=http://localhost:5173,https://mon-front.lovable.app

# Supabase -> Settings -> API
SUPABASE_URL=https://abcdefghijklmnopqrst.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service_role_key_factice_a_remplacer

# Bucket Supabase Storage (public) contenant les images produit
SUPABASE_STORAGE_BUCKET=product-images

# =============================================================================
# Agent d'extraction (POST /products/extract) -- src/agents/product_extraction/
# =============================================================================
# ATTENTION : l'agent appelle `load_dotenv(override=True)` a son import. Les valeurs de
# CE fichier .env ecrasent donc les variables d'environnement reellement injectees
# (CI, service systemd...), y compris DATABASE_URL et SUPABASE_*. Si tu injectes ces
# variables autrement que par .env, supprime le .env du disque ou aligne les deux.
# Voir le README, section "Effet de bord .env".

# --- Secrets : uniquement par variable d'environnement, jamais en dur dans le code -----
# Requis seulement si use_agent=true (normalisation LLM). https://platform.openai.com
OPENAI_API_KEY=sk-cle-openai-factice-a-remplacer
# Requis seulement pour les URLs routees vers un acteur Apify (Amazon, Temu, AliExpress,
# Walmart, eBay...). https://console.apify.com/settings/integrations
APIFY_API_TOKEN=apify_api_token_factice_a_remplacer

# --- Reglages de l'agent (lus UNE SEULE FOIS a son import) ----------------------------
# Pays acheteur par defaut de l'agent. La region reellement utilisee est celle envoyee
# dans chaque requete ; PRODUCT_COUNTRY ne sert plus que de valeur de repli.
PRODUCT_COUNTRY=MA
# 1 = lister aussi les variantes (tailles/couleurs) du produit. 0 = une URL, un produit.
PRODUCT_VARIANTS=0
# Modele OpenAI utilise quand use_agent=true.
OPENAI_MODEL=gpt-5-nano

# --- Reglages du domaine products -----------------------------------------------------
# Regions ISO 3166-1 alpha-2 acceptees par POST /products/extract.
# VIDE = AUCUNE RESTRICTION, et c'est le defaut. Renseigner la variable restreint aux
# seules regions listees ; toute autre valeur donne alors un 422.
# Reserve propre a l'extraction : treize pays ont un profil de navigateur (langue, fuseau,
# Accept-Language). Ailleurs le navigateur se presente en en-US/UTC, et une boutique qui
# change de devise sur ces en-tetes affichera son prix americain. L'extraction reussit,
# le chiffre est reel -- c'est le prix vu par un autre visiteur.
EXTRACTION_ALLOWED_REGIONS=
# Extractions simultanees. Chaque extraction Playwright demarre son propre Chromium
# (~300 Mo) : cette valeur borne la memoire autant que la charge.
EXTRACTION_MAX_CONCURRENCY=1
# Budget global par extraction, attente d'un creneau incluse. Au-dela : 504.
EXTRACTION_TIMEOUT_SECONDS=300

# =============================================================================
# Etudes de marche (domaine studies -- lot F8.1)
# =============================================================================
# true : enregistrer un produit (POST /products ou POST /products/extract) cree
# automatiquement une etude. false : le produit est stocke, aucune etude n'est creee ;
# POST /studies reste disponible pour la creation manuelle.
STUDY_AUTO_START=true
# Regions ISO 3166-1 alpha-2 pour lesquelles une etude peut etre lancee. Reglage distinct
# d'EXTRACTION_ALLOWED_REGIONS.
# VIDE = AUCUNE RESTRICTION, et c'est le defaut : le pipeline resout une devise et une
# langue pour 244 pays. Un pays absent de ses tables arrete l'etude sur
# CURRENCY_NOT_MAPPED avant le premier collecteur, donc sans depense.
STUDY_ALLOWED_REGIONS=
# Nombre de lancements d'un module, reprises comprises : 3 = un essai et deux reprises.
# Un collecteur qui revient vide est rejoue, car une collecte vide et un appel au modele
# perdu se ressemblent de l'exterieur. Une region non couverte et une entree inexploitable
# ne le sont jamais : elles redonneraient le meme resultat.
STUDY_COLLECTOR_ATTEMPTS=3
# Attente avant chaque reprise, en secondes.
STUDY_RETRY_BACKOFF_SECONDS=20

# --- Cles du pipeline d'etude (src/agents/market_study/) ------------------------------
# Manquantes : l'application demarre quand meme, avec un avertissement par cle, et les
# modules qui en ont besoin echouent en le disant. Voir docs/pipeline_contrats.md.
# Requise par les 11 modules. https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-cle-factice-a-remplacer
# Requis par 5 collecteurs (Tendances, Reddit, Recherche web, Amazon, Meta Ads).
# APIFY_API_TOKEN, deja present plus haut pour l'extraction, sert de repli.
APIFY_TOKEN=apify_api_token_factice_a_remplacer
# Sel d'anonymisation des pseudonymes Reddit. Sans lui, un sel public de repli est
# utilise et l'anonymisation est affaiblie : a renseigner avec une valeur aleatoire longue.
SEL_ANONYMISATION=chaine-aleatoire-longue-a-remplacer
# Quadruplet AliExpress (API Dropshipping officielle).
ALIEXPRESS_APP_KEY=000000
ALIEXPRESS_APP_SECRET=secret_factice_a_remplacer
ALIEXPRESS_ACCESS_TOKEN=token_factice_a_remplacer
ALIEXPRESS_REFRESH_TOKEN=refresh_factice_a_remplacer

# --- Execution du pipeline ------------------------------------------------------------
# Une etude a la fois : ~2,3 $ de credits LLM, des credits Apify et plusieurs centaines
# de Mo. Cette valeur borne la depense autant que la charge.
STUDY_MAX_CONCURRENCY=1
# Collecteurs simultanes. Les six sont independants par conception : a 6, la phase de
# collecte coute le collecteur le plus lent au lieu de leur somme. Le cout API est
# inchange (memes appels, memes tokens). Les vraies limites sont operationnelles : runs
# d'actors Apify concurrents (5 collecteurs sur 6 passent par Apify), debit Anthropic,
# RAM (6 sous-processus Python). En cas d'erreurs de quota recurrentes : baisser a 3-4.
STUDY_COLLECT_PARALLEL=2
# Budgets par module. Mesures : 13 min pour les 6 collecteurs, 666 s pour F4 (le pire).
STUDY_TIMEOUT_COLLECTOR_SECONDS=1200
STUDY_TIMEOUT_ANALYSIS_SECONDS=1800
# Les deux seuls leviers de cout de la collecte : Amazon facture UN run d'actor par
# produit enrichi d'avis, Meta facture A L'ANNONCE. Baisser pour un run de validation.
STUDY_AMAZON_AVIS=5
STUDY_META_ANNONCES=30
# Espace de travail des etudes (gitignore). Conserve par defaut : les JSON intermediaires
# font foi en cas de doute sur une formulation du rapport. Purge manuelle.
STUDY_WORKDIR=var/studies
STUDY_KEEP_WORKDIR=true
# Racine du pipeline. A ne changer que pour pointer une copie ailleurs.
STUDY_PIPELINE_ROOT=src/agents/market_study
# Interpreteur des modules. Vide = celui de l'application (recommande). Le pipeline a ete
# valide sous Python 3.14 ; renseigner un autre venv est l'echappatoire si besoin.
STUDY_PYTHON_EXECUTABLE=
