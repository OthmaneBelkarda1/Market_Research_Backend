# Clé API Anthropic — étapes LLM (contrôle qualité de la fiche, dérivation des
# requêtes marketplace).
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Identifiants de l'application AliExpress Open Platform.
# L'AppKey et l'AppSecret se lisent dans la console développeur ; ils ne se
# régénèrent PAS à chaque exécution.
ALIEXPRESS_APP_KEY=000000
ALIEXPRESS_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tokens issus de l'autorisation OAuth initiale (clic humain, une seule fois).
# Statut d'app « Test » : access_token valide 24 h, refresh_token valide 48 h.
# Le module rafraîchit seul l'access_token et écrit le résultat dans
# .tokens.json, qui prime alors sur ces deux valeurs. Ce fichier .env n'est
# jamais modifié par le module.
ALIEXPRESS_ACCESS_TOKEN=50000000000xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ALIEXPRESS_REFRESH_TOKEN=50001000000xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
